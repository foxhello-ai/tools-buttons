{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-actions:config:1",
  "title": "Project Actions configuration",
  "type": "object",
  "required": [
    "version",
    "actions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "tooltip",
          "command"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "icon": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "tooltip": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "timeout": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 86400
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "workflow": {
            "type": "object",
            "properties": {
              "nodes": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/node"
                }
              }
            }
          },
          "parameters": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "$ref": "#/$defs/parameter"
            }
          },
          "previewCommand": {
            "$ref": "#/$defs/command"
          },
          "inputTimeout": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 120,
            "default": 30
          },
          "resume": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "nodes"
            ],
            "properties": {
              "nodes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/id"
                }
              }
            }
          }
        },
        "dependentRequired": {
          "resume": [
            "previewCommand"
          ]
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "node": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "details": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": [
          "label",
          "value"
        ],
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 16384
          },
          "value": {
            "type": "string",
            "maxLength": 16384
          }
        }
      }
    },
    "option": {
      "type": "object",
      "required": [
        "label",
        "value"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "value": {},
        "details": {
          "$ref": "#/$defs/details"
        },
        "disabledReason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "label",
        "type"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "type": {
          "enum": [
            "select",
            "text",
            "number",
            "boolean"
          ]
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "default": {},
        "options": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "optionsCommand": {
          "$ref": "#/$defs/command"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "select"
              }
            }
          },
          "then": {
            "oneOf": [
              {
                "required": [
                  "options"
                ],
                "not": {
                  "required": [
                    "optionsCommand"
                  ]
                }
              },
              {
                "required": [
                  "optionsCommand"
                ],
                "not": {
                  "required": [
                    "options"
                  ]
                }
              }
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "options"
                  ]
                },
                {
                  "required": [
                    "optionsCommand"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
