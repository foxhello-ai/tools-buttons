{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-actions:config:1",
  "title": "Project Actions configuration",
  "type": "object",
  "required": ["version", "actions"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 1},
    "project": {
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "actions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "tooltip", "command"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "icon": {"type": "string", "minLength": 1, "maxLength": 32},
          "tooltip": {"type": "string", "minLength": 1, "maxLength": 256},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "cwd": {"type": "string", "minLength": 1},
          "timeout": {"type": "number", "exclusiveMinimum": 0, "maximum": 86400},
          "env": {"type": "object", "additionalProperties": {"type": "string"}},
          "workflow": {
            "type": "object",
            "properties": {
              "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
    "node": {
      "type": "object", "required": ["id"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1, "maxLength": 128},
        "dependsOn": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    }
  }
}
